# Copy to .env.local. Local values come from `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only "Secret key" from `npx supabase status`. Writes payment links and handles webhooks.
SUPABASE_SECRET_KEY=

# Signs payment approvals so a client can't forge one. Generate: openssl rand -base64 32
TOOL_APPROVAL_SECRET=

# Models: Sarvam is the main LLM (https://dashboard.sarvam.ai), Claude is the fallback.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=
MUNSHI_FALLBACK_MODEL=claude-opus-5-5
# Voice uses the same Sarvam key: Saaras v4 (speech to text) and Bulbul (text to speech).
# Optional overrides, e.g. SARVAM_TTS_MODEL=bulbul:v4-flash with a matching persona speaker.
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=

# Cashfree Payment Gateway sandbox keys (Developers > API Keys in the Cashfree dashboard).
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# Public https URL of this app, so Cashfree can call /api/webhooks/cashfree. Leave empty locally.
PUBLIC_APP_URL=

# Telegram bot: message @BotFather on Telegram, send /newbot, and paste the token here.
# Locally, run `npm run telegram:dev` next to `npm run dev`: no public URL needed.
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (optional, not yet live-tested) (developers.facebook.com → your app → WhatsApp → API Setup).
# The temporary access token from API Setup expires after 24 hours; a system user token doesn't.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App settings → Basic → App secret. Verifies that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Any string you choose; paste the same one into the webhook settings in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=
# The test number shown in API Setup, e.g. 15551234567. Used for the "Open in WhatsApp" link.
WHATSAPP_DISPLAY_NUMBER=

# Vercel Cron sends this as a Bearer token to /api/cron/reminders. Generate: openssl rand -base64 32
CRON_SECRET=

# Observability (https://cloud.langfuse.com). Tracing is off when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
