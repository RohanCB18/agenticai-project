# Copy to .env.local. Local values come from `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Used later for Cashfree webhooks writing payment_links.
SUPABASE_SECRET_KEY=

# Observability (https://cloud.langfuse.com). Tracing is off when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Phase 1+ (leave empty for now)
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
SARVAM_API_KEY=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
